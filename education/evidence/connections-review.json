  "findings": [
    {
      "id": "connection-summary-real-visual",
      "finding": "Symmetry curriculum claimed square vertex labels absent from this new vector-based lab.",
      "owner": "education_curriculum",
      "resolution": "Replaced the claim with the actual complex-plane vectors, complex formulas and real matrices.",
      "status": "source-fix-verified"
    },
    {
      "id": "initial-snapshot-order",
      "finding": "Parent passive reset could discard the child initial snapshot and disable saving until parameters changed.",
      "owner": "root",
      "resolution": "Snapshot state bound to selected connection; default save enabled in every one of the 24 final configurations.",
      "status": "verified-final-browser"
    },
    {
      "id": "structure-mobile-label-size",
      "finding": "12-unit SVG labels would scale to roughly 9 CSS pixels in nested mobile panels.",
      "owner": "education_atlas",
      "resolution": "Larger mobile labels, less nested padding, zoom/keyboard scrolling and 44px controls. Across all six final 390px scenes the smallest measured SVG text size was 14.914 CSS pixels.",
      "status": "verified-final-browser-and-screenshot"
    },
    {
      "id": "cdf-jump-meaning",
      "finding": "Vertical lines at CDF jumps could be mistaken for function values.",
      "owner": "education_advanced",
      "resolution": "Added hollow left-limit and filled right-continuous-value dots, with bilingual explanation that vertical segments only mark jumps.",
      "status": "verified-final-source-and-browser"
    },
    {
      "id": "mapping-glyph-missing",
      "finding": "An actual Chinese mobile screenshot showed a missing glyph for the mapsto character in new connection prose.",
      "owner": "education_atlas, education_labs, education_curriculum",
      "resolution": "Changed the affected mapping statements to Chinese/English words; rebuilt and reran all 24 states and 7 integration checks.",
      "status": "verified-final-source-and-browser"
    },
    {
      "id": "notebook-byte-capacity",
      "finding": "A valid local notebook could otherwise grow beyond the 5 MiB import limit; pretty JSON could also cross the limit after size validation.",
      "owner": "root",
      "resolution": "Validate combined compact UTF-8 bytes, show a visible capacity error, preserve previous records, and export the same compact JSON encoding. Independently rejected a 60+40-record Chinese-text merge and roundtripped a real 5,241,855-byte, 90-record export in fresh browser contexts.",
      "status": "verified-unit-and-final-browser"
    },
    {
      "id": "storage-event-writeback",
      "finding": "The persistence effect could write incoming storage events back to another tab.",
      "owner": "root",
      "resolution": "Persist only user writes. Independent two-tab test measured writes [2,1], with zero event-driven writebacks after saves and deletion.",
      "status": "verified-final-browser"
    },
    {
      "id": "d4-touch-control-height",
      "finding": "The visual reviewer measured D4 selects at 42px and range inputs at 28px on the compact layout after the full audit.",
      "owner": "root",
      "resolution": "Root changed only the three discrete CSS control-height rules. Independent follow-up checked all six D4 controls in Chinese/English at 1440px and 390px: every control is 44 CSS pixels high, no overflow or runtime errors, and axe reports zero violations.",
      "status": "verified-focused-browser",
      "buildIndexSha256": "953216d4164fa281000de240df983c97c77523c2107907ff7ddc68bf3e37ed20"
    }
  ],
