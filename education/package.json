{
  "name": "mathcups-island-education",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/collect_runtime_licenses.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "data:build": "python scripts/build_atlas_index.py",
    "verify:core": "python scripts/verify_core.py --baseline docs/publication-base.json",
    "test:browser": "node scripts/browser-audit.mjs",
    "test:a11y": "node scripts/accessibility-audit.mjs",
    "test:connections:browser": "node scripts/connections-audit.mjs",
    "verify:publication": "python scripts/verify_core.py --baseline docs/publication-base.json --require-git",
    "verify:historical-core": "python scripts/verify_core.py --baseline docs/core-baseline.json"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
